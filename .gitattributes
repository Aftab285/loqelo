# Normalise line endings so Windows and macOS/Linux contributors agree.
* text=auto eol=lf

# Text files people edit by hand
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.toml   text eol=lf
*.txt    text eol=lf
*.xml    text eol=lf
_headers text eol=lf

# Binary assets — never diff, never convert
*.mp4    binary
*.webp   binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.ico    binary
*.ttf    binary
*.woff   binary
*.woff2  binary
*.ai     binary
*.pdf    binary
